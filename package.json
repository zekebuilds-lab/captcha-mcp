    "mcp",
    "mcp-server",
    "model-context-protocol",
    "modelcontextprotocol",
    "claude",
    "ai",
    "agent",
    "agent-auth",
    "captcha",
    "proof-of-work",
    "lightning",
    "l402",
    "rate-limiting",
    "rate-limit-replacement",
    "429",
    "429-replacement",
    "402-mcp",
    "backoff",
    "anti-bot",
    "powforge"
  ],
  "main": "src/index.js",
  "bin": {
    "captcha-mcp": "src/server.js"
  },
  "scripts": {
    "test": "node --test tests/server.test.js tests/http-transport.test.js tests/rune-fairlaunch.test.js tests/rune-broadcast.test.js",
    "start": "node src/server.js",
    "start:http": "node src/server.js --http"
  },
